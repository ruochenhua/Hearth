# Run `npm run setup` to generate a private password.
ALBUM_PASSWORD=replace-with-a-unique-password-at-least-12-characters
PORT=3080
HOST=0.0.0.0
DATA_DIR=./data
IMPORT_DIR=./inbox
TZ=Asia/Shanghai
# Set to true only behind HTTPS.
COOKIE_SECURE=false
# Optional absolute paths when ffmpeg/ffprobe/adb are not in PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# ADB_PATH=adb
# If Docker Hub is unreachable, the same official image is available through Amazon ECR:
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-bookworm-slim
